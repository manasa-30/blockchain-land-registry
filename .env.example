# Optional local IPFS Kubo HTTP API. Prefer a loopback-only endpoint for demos.
# For a production Pinata integration, call it through a secured backend proxy.
VITE_IPFS_API_URL=http://127.0.0.1:5001
VITE_RPC_URL=http://127.0.0.1:8545

# Optional Sepolia configuration is intentionally not enabled by default.
# SEPOLIA_RPC_URL=
# DEPLOYER_PRIVATE_KEY=
